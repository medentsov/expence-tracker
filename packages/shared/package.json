{
	"name": "@tracker/shared",
	"version": "0.0.1",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsc --noEmit",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write --ignore-path ../../.prettierignore \"**/*.{ts,tsx,json,md,css}\"",
		"format:check": "prettier --check --ignore-path ../../.prettierignore \"**/*.{ts,tsx,json,md,css}\""
	},
	"devDependencies": {
		"typescript": "^5.5.0",
		"vitest": "^5.0.5"
	}
}
