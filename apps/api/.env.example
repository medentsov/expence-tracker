# Строка подключения к PostgreSQL (см. docker-compose.yml в корне)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"

# Порт API
PORT=3001

# Секрет для подписи JWT (обязательно заменить в продакшене)
JWT_SECRET="dev-secret-change-me-in-production"

# Срок жизни access-токена
JWT_EXPIRES_IN="7d"