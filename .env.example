# DATABASE_URL — строка подключения к PostgreSQL (см. docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"

# Порт NestJS API
PORT=3001

# Порт Next.js (по умолчанию 3000)
# WEB_PORT=3000

# Базовый URL API для фронтенда
NEXT_PUBLIC_API_URL="http://localhost:3001"